# Copy this file to .env and replace values for the local installation.
RECIPE_DB_URL=http://127.0.0.1:8000
RECIPE_DB_NAMESPACE=recipe_creator
RECIPE_DB_DATABASE=recipe_creator
RECIPE_DB_USER=root
RECIPE_DB_PASSWORD=recipe-local-only

# The `make db` target uses these matching local defaults.
SURREAL_PATH=surrealkv://.data/recipe-creator
SURREAL_BIND=127.0.0.1:8000
SURREAL_USER=root
SURREAL_PASS=recipe-local-only

# Use false only while developing over local HTTP.
RECIPE_SECURE_COOKIES=false
RECIPE_PUBLIC_ORIGIN=http://localhost:2772
RECIPE_ALLOWED_ORIGINS=["http://localhost:2772"]
WEB_CONCURRENCY=1

# Optional features.
# RECIPE_AI_API_KEY=
# RECIPE_ADMIN_PASSWORD_HASH=
# RECIPE_SESSION_SECRET=
