{
  "name": "recipe-creator-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 2772 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 2772 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "bash -o pipefail -c 'uv run --project ../recipe-creator-backend python -m recipe_creator.cli export-openapi | openapi-typescript -o src/api.generated.ts'"
  },
  "dependencies": {
    "@lucide/svelte": "^1.42.0",
    "browser-image-compression": "^2.0.2",
    "diff": "9.0.0",
    "eruda": "^3.4.3",
    "qrcode": "^1.5.4",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "svelte-check": "^4.3.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
